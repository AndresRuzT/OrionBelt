# =============================================================================
# ORION | Optical Recognition & Intelligent Obstacle Navigation
# Plantilla de Configuración del Entorno (.env.example)
# =============================================================================
# Copia este archivo como '.env' y ajusta los valores según tu configuración local.
# Nota: '.env' está protegido en .gitignore y nunca debe subirse al repositorio.

# -----------------------------------------------------------------------------
# 🌐 Servidor Web & Dashboard
# -----------------------------------------------------------------------------
ORION_VERSION=5
ORION_HOST=0.0.0.0
ORION_PORT=8000

# -----------------------------------------------------------------------------
# 📷 Hardware IoT: Seeed Studio XIAO ESP32S3 Sense
# -----------------------------------------------------------------------------
# IP del microcontrolador (dejar vacío para auto-descubrimiento por Faro UDP o caché)
XIAO_IP=172.16.121.142
XIAO_STREAM_PORT=81
XIAO_CTRL_PORT=80

# -----------------------------------------------------------------------------
# 💻 Cámara Local de Respaldo (Rollback automático ante pérdida de Wi-Fi)
# -----------------------------------------------------------------------------
# Índice de cámara de tu computadora (0 para webcam integrada)
FALLBACK_SRC=0

# -----------------------------------------------------------------------------
# 🧠 Inteligencia Artificial: Estimación de Profundidad Monocular (MiDaS)
# -----------------------------------------------------------------------------
# Dispositivo de aceleración: auto, cuda (NVIDIA), mps (Apple Silicon), cpu
DEVICE=auto

# Tipo de arquitectura MiDaS: MiDaS_small, DPT_Large, DPT_Hybrid
MODEL_TYPE=MiDaS_small

# Ancho de procesamiento de fotogramas (320 para alta velocidad a 30 FPS)
PROC_WIDTH=320

# Factor de suavizado temporal SIMD entre fotogramas (0.0 a 1.0)
TEMPORAL_ALPHA=0.65

# -----------------------------------------------------------------------------
# 🚨 Detección de Obstáculos y Alarmas
# -----------------------------------------------------------------------------
# Umbral relativo de proximidad en pasillo central (0.0 a 1.0, por defecto 0.6)
NEAR_THRESHOLD=0.60

# Potencia PWM del buzzer del XIAO (0 a 255) y duración en ms
BUZZER_DUTY=200
BUZZER_DURATION=150

# Alarma sonora en la computadora (true / false)
ENABLE_LOCAL_SOUND=true
